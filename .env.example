# --- Hindsight ---------------------------------------------------------------
# Hindsight Cloud: use the API URL + key from https://ui.hindsight.vectorize.io
# Self-hosted:     http://localhost:8888 and leave the key empty
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# Prefix for every bank this project creates (lets you run several copies side by side)
BANK_PREFIX=rz

# --- Groq ---------------------------------------------------------------------
GROQ_API_KEY=
# Text reasoning model (Groq production). Fallback is used if the primary errors out.
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Vision model for draft attribute extraction. Llama 4 Scout was retired on Groq (2026-07-17).
VISION_MODEL=qwen/qwen3.8-27b
